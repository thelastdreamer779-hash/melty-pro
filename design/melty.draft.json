      "to": "{game}/hollow_knight_Data/Managed/Mods/TurnipDash"
    },
    {
      "component": "main",
      "from": "README.md",
      "to": "{game}/hollow_knight_Data/Managed/Mods/TurnipDash"
    },
    {
      "component": "main",
      "from": "THIRD-PARTY-NOTICES.txt",
      "to": "{game}/hollow_knight_Data/Managed/Mods/TurnipDash"
    },
    {
      "component": "main",
      "from": "TurnipDash.dll",
      "to": "{game}/hollow_knight_Data/Managed/Mods/TurnipDash"
